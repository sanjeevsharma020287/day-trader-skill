[{"an_dt":"11-Nov-2026 18:59:05","attFileSize":"583.61 KB","attchmntFile":"https://nsearchives.nseindia.com/corporate/AmitDodani_11112026185839_Intimation_Transcript_Q2F27_Earningscall_05112026.pdf","attchmntText":"Mahindra & Mahindra Limited has informed the Exchange about Transcript of M&M Analyst Meet Q2F27","bflag":null,"csvName":null,"desc":"Analysts/Institutional Investor Meet/Con. Call Updates","difference":"00:00:00","dt":"11112026185905","exchdisstime":"11-Nov-2026 18:59:05","fileSize":"583.61 KB","hasXbrl":true,"old_new":null,"orgid":null,"seq_id":"106855618","smIndustry":"Automobiles - 4 Wheelers","sm_isin":"INE101A01026","sm_name":"Mahindra & Mahindra Limited","sort_date":"2026-11-11 18:59:05","symbol":"M&M","voiceSummary":"Mahindra and Mahindra submitted the transcript of its Q2 FY27 earnings conference call held on 5th November 2026. Consolidated revenue rose 25% to Rs. 57,553 crores, with profit after tax increasing 25% to Rs. 4,588 crores. Return on equity stood at 21%. Auto business profit grew 55%, while Farm sector profit declined 9%. Mahindra Finance profit increased 61%, and Tech M profit rose 33%. Logistics showed a significant turnaround, and Accelo profit grew 70%. The company maintained its long-term targets of 15% to 20% EPS growth and 18% RoE. Management highlighted resilience against commodity inflation and geopolitical challenges. No unpublished price sensitive information was shared during the meet. The transcript is available on the company website.","voiceUrl":"https://nsearchives.nseindia.in/ann_voice/AmitDodani_11112026185839_Intimation_Transcript_Q2F27_Earningscall_05112026.mp3"},{"an_dt":"11-Nov-2026 14:55:45","attFileSize":"379.54 KB","attchmntFile":"https://nsearchives.nseindia.com/corporate/AmitDodani_11112026145521_UpcomingAnalystMeet16112026.pdf","attchmntText":"Mahindra & Mahindra Limited has informed the Exchange about Schedule of meet","bflag":null,"csvName":null,"desc":"Analysts/Institutional Investor Meet/Con. Call Updat